{
  "name": "react-native-voice-activator-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "CI=1 expo prebuild --no-install --platform android && expo run:android",
    "ios": "CI=1 expo prebuild --no-install --platform ios && expo run:ios",
    "ios:device": "CI=1 expo prebuild --no-install --platform ios && expo run:ios --device",
    "start": "expo start",
    "prebuild": "CI=1 expo prebuild --no-install --clean",
    "build:android": "react-native build-android --extra-params \"--no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a\"",
    "build:ios": "react-native build-ios --mode Debug --verbose",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@dr.pogodin/react-native-fs": "2.40.3",
    "@react-native/new-app-screen": "0.86.3",
    "expo": "^57.0.0",
    "expo-dev-client": "~57.0.19",
    "expo-speech": "~57.0.3",
    "onnxruntime-react-native": "^1.24.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-audio-recorder-player": "4.5.0",
    "react-native-nitro-modules": "0.31.10",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-voice-activator": "portal:..",
    "whisper.rn": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^8.0.6",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "^19.2.0",
    "patch-package": "^8.0.1",
    "react-native-builder-bob": "^0.43.1",
    "react-native-monorepo-config": "^0.4.0"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  }
}
