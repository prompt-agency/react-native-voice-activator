require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

# Use onnxruntime-react-native's ORT (1.24.x) as the single ORT in the app.
# This prevents a duplicate-symbol link conflict between sherpa-onnxruntime.xcframework
# (ORT 1.17.1 bundled with the wake-word library) and onnxruntime-c (1.24.x from
# onnxruntime-react-native). Sherpa-onnx compiled against ORT API v17 runs fine on
# ORT 1.24.x because the C API is backward-compatible.
ENV['RUNANYWHERE_ONNX_COMPAT'] = '1'

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']

  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true'
ENV['RCT_HERMES_V1_ENABLED'] ||= '1' if podfile_properties['expo.useHermesV1'] == 'true'
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'VoiceActivatorExample' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    installer.pods_project.targets.each do |target|
      next unless target.name == 'ExpoModulesCore'

      target.build_configurations.each do |build_configuration|
        build_configuration.build_settings['SWIFT_STRICT_CONCURRENCY'] = 'minimal'
      end
    end

    # VoiceActivator vendors sherpa-onnxruntime headers (older ORT C++ API). CocoaPods
    # also exposes them under Headers/Private/VoiceActivator; without ordering, the
    # onnxruntime-react-native pod can resolve onnxruntime_cxx_api.h to Sherpa's copy
    # and fail (e.g. missing AddExternalInitializersFromFilesInMemory).
    #
    # Prepend ORT headers but keep $(inherited): reading build_settings['HEADER_SEARCH_PATHS']
    # here does not include the pod xcconfig, so replacing with a joined string would drop
    # React-jsi / ReactCommon paths and break <jsi/jsi.h>.
    installer.pods_project.targets.each do |target|
      next unless target.name == 'onnxruntime-react-native'

      ort_headers = '"${PODS_ROOT}/onnxruntime-c/Headers"'
      target.build_configurations.each do |build_configuration|
        existing = build_configuration.build_settings['HEADER_SEARCH_PATHS']
        unless existing.is_a?(Array) && existing.any? { |p| p.to_s.include?('onnxruntime-c/Headers') } ||
               (!existing.is_a?(Array) && existing.to_s.include?('onnxruntime-c/Headers'))
          if existing.is_a?(Array)
            build_configuration.build_settings['HEADER_SEARCH_PATHS'] = [ort_headers, '$(inherited)']
          else
            build_configuration.build_settings['HEADER_SEARCH_PATHS'] = "#{ort_headers} $(inherited)"
          end
        end

        # CocoaPods VFS / header maps can still bind onnxruntime_cxx_api.h to VoiceActivator's
        # Sherpa copy; disable the header map so -I .../onnxruntime-c/Headers wins.
        build_configuration.build_settings['USE_HEADERMAP'] = 'NO'
      end
    end

    # ── Sherpa TTS: auto-download espeak-ng-data ─────────────────────────────
    #
    # SherpaOnnxTTSAdapter needs espeak-ng-data/ at build time.
    # This block downloads it from sherpa-onnx releases on first pod install.
    #
    # The files land in ios/espeak-ng-data/ which is already wired into the
    # Xcode project as a PBXFileSystemSynchronizedRootGroup — Xcode 16 will
    # automatically include the directory in the app bundle.
    #
    # After pod install, do a clean build in Xcode (⇧⌘K → ⌘B).

    espeak_src  = File.join(__dir__, 'espeak-ng-data')
    tarball_url = 'https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/vits-piper-en_US-ryan-low.tar.bz2'

    unless File.exist?(espeak_src)
      puts "\n[Sherpa TTS] Downloading espeak-ng-data (one-time, ~65 MB)..."
      tmp = '/tmp/sherpa-piper-setup'
      system("rm -rf '#{tmp}' && mkdir -p '#{tmp}'")
      ok = system("curl -L --progress-bar '#{tarball_url}' | tar -xj -C '#{tmp}'")
      extracted = File.join(tmp, 'vits-piper-en_US-ryan-low')
      if ok && File.exist?(File.join(extracted, 'espeak-ng-data'))
        system("cp -r '#{extracted}/espeak-ng-data' '#{__dir__}/'")
        system("rm -rf '#{tmp}'")
        puts "[Sherpa TTS] espeak-ng-data ready at #{espeak_src} ✓"
        puts "[Sherpa TTS] Do a clean build in Xcode (⇧⌘K → ⌘B) to bundle the data."
      else
        puts "[Sherpa TTS] WARNING: Download failed. Run example/scripts/setup-sherpa-tts.sh manually."
      end
    end
  end
end
