{
  "expo": {
    "name": "VoiceActivatorExample",
    "slug": "voice-activator-example",
    "plugins": [
      [
        "../app.plugin.js",
        {
          "microphonePermissionText": "This app uses the microphone to detect wake words."
        }
      ],
      "./plugins/with-ui-scene-lifecycle.js",
      "./plugins/with-sherpa-tts-assets.js"
    ],
    "android": {
      "package": "com.anonymous.voiceactivatorexample"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.voiceactivatorexample",
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "EXExpoAppSceneDelegate"
              }
            ]
          }
        }
      },
      "appleTeamId": "33C5QGLZBB"
    }
  }
}
