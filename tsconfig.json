{
  // Build outputs only. `lib/` contains the emitted .d.ts for everything in
  // `src/`, so compiling both puts each ambient `declare module` in scope
  // twice and tsc reports duplicate identifiers. Everything else (example,
  // docs, tests) stays in scope so this still typechecks what CI used to.
  "exclude": ["lib", "plugin/build"],
  "compilerOptions": {
    "rootDir": ".",
    "paths": {
      "react-native-voice-activator": ["./src/index"],
      "whisper.rn": ["./src/vendor-types/whisper-rn"],
      "onnxruntime-react-native": ["./src/vendor-types/onnxruntime-react-native"]
    },
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "customConditions": ["react-native-strict-api"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noImplicitUseStrict": false,
    "noStrictGenericChecks": false,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["jest", "node"],
    "verbatimModuleSyntax": true
  }
}
