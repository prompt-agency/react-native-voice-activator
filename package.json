{
  "name": "react-native-voice-activator",
  "version": "0.1.0",
  "description": "React Native and Expo wake word detection library",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./plugin": "./plugin/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "THIRD-PARTY-NOTICES.md",
    "scripts/fetch-silero-vad-model.mjs",
    "android",
    "ios",
    "cpp",
    "plugin",
    "app.plugin.js",
    "*.podspec",
    "react-native.config.js",
    "!ios/build",
    "!ios/Vendor",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/libs",
    "!ios/Assets",
    "!android/src/main/assets",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*",
    "!**/test_wavs",
    "!**/*-epoch-12-avg-2-chunk-16-left-64.onnx"
  ],
  "scripts": {
    "example": "yarn workspace react-native-voice-activator-example",
    "verify:expo-config-resolution": "node scripts/verify-expo-config-resolution.mjs",
    "verify:expo-prebuild": "node scripts/verify-expo-prebuild.mjs",
    "evaluate:reliability": "node scripts/run-reliability-evaluation.mjs",
    "generate:model-manifest": "node scripts/generate-model-manifest.mjs",
    "package:models": "node scripts/package-models.mjs",
    "package:ios-vendor": "node scripts/package-ios-vendor-frameworks.mjs",
    "verify:vendor-checksums": "node scripts/verify-vendor-checksums.mjs",
    "verify:contracts": "yarn build:plugin && node scripts/verify-example-setup.mjs && node scripts/verify-doc-links.mjs && node scripts/verify-expo-runtime-compatibility.mjs && yarn verify:expo-config-resolution && yarn verify:expo-prebuild && node scripts/verify-reliability-evidence.mjs && yarn verify:vendor-checksums",
    "verify:release-readiness": "yarn lint && yarn typecheck && yarn test --runInBand --watchman=false && yarn prepare && yarn typecheck && npm_config_cache=.npm-cache npm pack --dry-run",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint app.plugin.js plugin/index.js \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" --ignore-pattern \"plugin/build/**\" --ignore-pattern \"lib/**\" --no-warn-ignored && yarn verify:contracts",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "prepare": "node scripts/fetch-silero-vad-model.mjs && node scripts/generate-model-manifest.mjs && bob build && yarn build:plugin",
    "release": "release-it --only-version"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "expo",
    "wake-word",
    "voice",
    "speech",
    "keyword-detection",
    "sherpa-onnx",
    "voice-activity-detection"
  ],
  "author": "Prompt Agency",
  "homepage": "https://github.com/prompt-agency/react-native-voice-activator",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/prompt-agency/react-native-voice-activator.git"
  },
  "bugs": {
    "url": "https://github.com/prompt-agency/react-native-voice-activator/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.3.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.35.0",
    "@evilmartians/lefthook": "^1.12.3",
    "@expo/config-plugins": "^55.0.6",
    "@react-native-community/cli": "20.0.1",
    "@react-native/babel-preset": "0.83.2",
    "@react-native/eslint-config": "^0.81.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "commitlint": "^19.8.1",
    "del-cli": "^6.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-audio-recorder-player": "^3.6.0",
    "react-native-builder-bob": "^0.40.18",
    "react-native-fs": "^2.20.0",
    "release-it": "^19.0.4",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=8.0.0",
    "onnxruntime-react-native": ">=1.20.0",
    "react": "*",
    "react-native": "*",
    "react-native-audio-recorder-player": ">=3.0.0",
    "react-native-fs": ">=2.0.0",
    "whisper.rn": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    },
    "onnxruntime-react-native": {
      "optional": true
    },
    "react-native-audio-recorder-player": {
      "optional": true
    },
    "react-native-fs": {
      "optional": true
    },
    "whisper.rn": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "jest": {
    "preset": "react-native",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/.claude/"
    ],
    "moduleNameMapper": {
      "^whisper\\.rn$": "<rootDir>/src/__mocks__/whisper.rn.js",
      "^onnxruntime-react-native$": "<rootDir>/src/__mocks__/onnxruntime-react-native.js"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true,
      "assets": [
        "sherpa-onnx.xcframework.zip",
        "sherpa-onnxruntime.xcframework.zip",
        "android/libs/sherpa-onnx-static-link-onnxruntime-1.12.29.aar",
        "dist-models/*"
      ]
    },
    "hooks": {
      "before:init": [
        "node scripts/verify-vendor-checksums.mjs --require-assets",
        "node scripts/package-models.mjs"
      ],
      "after:release": [
        "rm -rf sherpa-onnx.xcframework.zip sherpa-onnxruntime.xcframework.zip dist-models"
      ]
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "VoiceActivatorSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.voiceactivator"
    }
  },
  "expo": {
    "plugin": "./app.plugin.js"
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "version": "0.54.2"
  }
}
