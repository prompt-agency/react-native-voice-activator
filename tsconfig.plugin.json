{
  "compilerOptions": {
    "rootDir": "src/expo",
    "outDir": "plugin/build/src/expo",
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": false,
    "resolveJsonModule": true
  },
  "include": ["src/expo/**/*.ts"]
}
